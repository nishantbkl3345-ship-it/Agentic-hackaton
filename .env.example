# Postgres connection string (Neon or any Postgres). Required — the backend
# will not start without it.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Each mission in app/levels.py is assigned a different real LLM provider,
# so the game doubles as a comparison of how different real-world models
# hold up against the same attacks. Any provider left blank just falls back
# to a deterministic offline mock for that mission — the whole game runs
# fine with none of these set.

# level1 — The Weak Bot (FoodieBot)
ANTHROPIC_API_KEY=
# SENTINEL_MODEL=claude-sonnet-5

# level2 — The Agent (AgentBot)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# boss — SENTINEL-01 (AgentBot)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# level3 — The File Reader (DocBot)
GLM_API_KEY=
# GLM_MODEL=glm-4.5-flash
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# Not assigned to a mission by default — wire one in via a level's
# "provider" field in app/levels.py if you want to use it.
NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Optional: base URL used to build event join-code QR codes. Defaults to
# http://localhost:5173 (the frontend dev server) if left unset.
# FRONTEND_BASE_URL=http://localhost:5173
